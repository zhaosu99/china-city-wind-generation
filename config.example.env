# Example configuration for a local run.
# Copy to your shell profile (or source it before running) and edit.
WINDPAPER_ROOT=/path/to/repo
WINDPAPER_DATA=/path/to/input/data
WINDPAPER_RESULTS=/path/to/output
WINDPAPER_RESULTS_2425=/path/to/output_2425
WINDPAPER_CURVE_DIR=/path/to/output/farm_power_curves
WINDPAPER_ERA5_DIR=/path/to/ERA5
WINDPAPER_CDMET_DIR=/path/to/CDMet
WINDPAPER_INVENTORY=/path/to/wind_farms_inventory.csv
WINDPAPER_RAW_W_DIR=/path/to/raw_w
WINDPAPER_CITY_CAPACITY=/path/to/city_capacity_adjust_info.csv
WINDPAPER_UTILIZATION=/path/to/prov_wind_utility_rates.csv

# Final M4 calibration inputs
WINDPAPER_WIND_SMAPE_DIR=/path/to/wind_smape_enums
WINDPAPER_GEN_SMAPE_DIR=/path/to/full_gen_smape
WINDPAPER_SURF_DIR=/path/to/wind_surfaces
WINDPAPER_PATH_DIR=/path/to/wind_valley_paths
WINDPAPER_ENUM_DIR=/path/to/gen_enums_2013_2025
WINDPAPER_MODEL_MONTHLY=/path/to/prov_month_from_city.csv
WINDPAPER_OFFICIAL_MONTHLY=/path/to/official_prov_month.csv
WINDPAPER_CALIBRATION_OUT=/path/to/calibration_out
WINDPAPER_OPTIMAL_KB=/path/to/results/optimal_kb/optimal_kb.csv
WINDPAPER_KB=/path/to/parameters/gen_correction_M4prod_final.csv
WINDPAPER_PRE2012_OFFICIAL=/path/to/parameters/pre2012_official.csv
WINDPAPER_CALIBRATED_CITY_DIR=/path/to/results/calibrated_gen/gen/city
WINDPAPER_CITY_FINAL_DIR=/path/to/results/city_final
